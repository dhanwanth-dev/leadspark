# ===== LeadSpark — one client per deployment =====
# For the next client: copy this file to .env.local and change the values.
# No code changes needed for a normal launch.

# Agent (what the prospect sees)
AGENT_NAME=Rahul Sharma
AGENT_EMAIL=rahul@sharmaproperties.in
AGENT_PHONE=+919876543210
AGENT_WHATSAPP=919876543210
AGENT_COMPANY=Sharma Properties

# Public URL (set after Vercel deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dashboard password (simple single-client auth)
DASHBOARD_PASSWORD=leadspark-demo

# Gemini — free tier at https://aistudio.google.com/apikey
# App works in mock mode without this; add for live AI on the pitch call
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase — optional for first local demo (uses in-memory leads if empty)
# Create project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — optional until you want hot-lead email
# https://resend.com → API key. Free tier uses onboarding@resend.dev to YOUR email only.
RESEND_API_KEY=
RESEND_FROM=LeadSpark <onboarding@resend.dev>
